{
  "app-id": "io.github.ouvill.nagametv",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable",
    "org.freedesktop.Sdk.Extension.llvm21"
  ],
  "command": "nagametv",
  "default-branch": "stable",
  "finish-args": [
    "--share=network",
    "--own-name=org.mpris.MediaPlayer2.io.github.ouvill.nagametv.*",
    "--share=ipc",
    "--socket=x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--filesystem=xdg-pictures/nagametv:create",
    "--env=QT_QPA_PLATFORM=xcb"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "LIBCLANG_PATH": "/usr/lib/sdk/llvm21/lib",
      "CARGO_NET_OFFLINE": "true"
    }
  },
  "modules": [
    {
      "name": "libass",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib",
        "-Dfontconfig=enabled",
        "-Dtest=disabled",
        "-Dcompare=disabled",
        "-Dprofile=disabled"
      ],
      "post-install": [
        "install -Dm644 ../COPYING /app/share/licenses/nagametv/libass.txt"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/libass/libass/releases/download/0.17.5/libass-0.17.5.tar.xz",
          "sha256": "2dca25c0e0c837ddf00b52011b3f82cac1e4ddd3ad018227806b0c2288864acc"
        }
      ]
    },
    {
      "name": "gstreamer-qml6",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib",
        "-Dauto_features=disabled",
        "-Dqt6=enabled",
        "-Daudiofx=enabled",
        "-Dqt-x11=enabled",
        "-Dqt-egl=enabled"
      ],
      "post-install": [
        "install -Dm644 ../COPYING /app/share/licenses/nagametv/gst-plugins-good.txt"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://gstreamer.freedesktop.org/src/gst-plugins-good/gst-plugins-good-1.26.11.tar.xz",
          "sha256": "001deb0876d5d743cd3448abf74a27adec3fd850012fcb1b00994861bd6c1145"
        }
      ]
    },
    {
      "name": "nagametv",
      "buildsystem": "simple",
      "build-options": {
        "env": {
          "CARGO_HOME": "/run/build/nagametv/cargo",
          "CLANG_PATH": "/usr/lib/sdk/llvm21/bin/clang"
        }
      },
      "build-commands": [
        "cmake -S . -B _build -G Ninja -DCMAKE_INSTALL_PREFIX=/app -DNAGAMETV_DISTRIBUTION=ON",
        "CARGO_BUILD_JOBS=\"$FLATPAK_BUILDER_N_JOBS\" cmake --build _build",
        "cmake --install _build"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../../rust",
          "dest": "rust",
          "skip": ["target", "target-before-26.04", "crates"]
        },
        { "type": "dir", "path": "../../rust/crates/viewer-remote", "dest": "rust/crates/viewer-remote", "skip": ["target"] },
        { "type": "dir", "path": "../../rust/crates/viewer-epg-events", "dest": "rust/crates/viewer-epg-events", "skip": ["target"] },
        { "type": "dir", "path": "../../rust/crates/viewer-diagnostics", "dest": "rust/crates/viewer-diagnostics", "skip": ["target"] },
        { "type": "dir", "path": "../../rust/crates/viewer-comments", "dest": "rust/crates/viewer-comments", "skip": ["target"] },
        { "type": "dir", "path": "../../rust/crates/tsreadex", "dest": "rust/crates/tsreadex", "skip": ["target"] },
        { "type": "dir", "path": "../../rust/crates/libaribcaption", "dest": "rust/crates/libaribcaption", "skip": ["target"] },
        { "type": "dir", "path": "../../rust/crates/libaribcaption-sys", "dest": "rust/crates/libaribcaption-sys", "skip": ["target"] },
        { "type": "dir", "path": "../../assets", "dest": "assets" },
        { "type": "dir", "path": "../../translations", "dest": "translations" },
        { "type": "dir", "path": "../linux", "dest": "packaging/linux" },
        { "type": "file", "path": "../../CMakeLists.txt" },
        { "type": "file", "path": "../../scripts/with-build-lock.sh", "dest": "scripts" },
        {
          "type": "git",
          "url": "https://github.com/xqq/libaribcaption.git",
          "commit": "c64c23b8905ba514b87c9789269e9f66f949ffe0",
          "dest": "third_party/libaribcaption"
        },
        {
          "type": "git",
          "url": "https://github.com/xtne6f/tsreadex.git",
          "commit": "a82528ccb698fcd07b4da1bb2243e63d685c34a7",
          "dest": "third_party/tsreadex"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
