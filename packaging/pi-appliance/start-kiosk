#!/bin/sh
set -eu

: "${XDG_RUNTIME_DIR:?PAM did not start a user session}"
: "${WAYLAND_DISPLAY:?labwc did not create a Wayland display}"
: "${RUNTIME_DIRECTORY:?systemd did not create the kiosk runtime directory}"

# Publish before checking the stop request, so ExecStop can either signal this
# process or prevent it from starting the viewer. The PID survives exec.
printf '%s\n' "$$" > "$RUNTIME_DIRECTORY/viewer.pid.tmp"
mv -f "$RUNTIME_DIRECTORY/viewer.pid.tmp" "$RUNTIME_DIRECTORY/viewer.pid"
if [ -e "$RUNTIME_DIRECTORY/stopping" ]; then
    exit 0
fi

# labwc can select the EDID preferred mode even when the boot console used 1080p.
if ! wlr-randr --output HDMI-A-1 --mode 1920x1080@60Hz &&
   ! wlr-randr --output HDMI-A-1 --mode 1920x1080@59.94Hz; then
    echo "NagameTV kiosk: could not set the HDMI-A-1 mode. Leaving the output with labwc" >&2
fi

export PULSE_SERVER="unix:$XDG_RUNTIME_DIR/pulse/native"
export PULSE_SINK=nagametv-hdmi0
export NAGAMETV_AUDIO_SINK=pulsesink

# Keep labwc running after the wait so it can enable HDMI-A-1 on replug.
# PipeWire's stream rule keeps playback tied to HDMI0 while the sink is absent.
checks=5
until reason=$(timeout 1s pactl get-sink-volume "$PULSE_SINK" 2>&1); do
    checks=$((checks - 1))
    if [ "$checks" -eq 0 ]; then
        echo "NagameTV kiosk: HDMI0 sink unavailable after startup wait (${reason:-pactl timed out}). See nagametv-hdmi-audio.service" >&2
        break
    fi
    sleep 1
done

echo "NagameTV kiosk: starting NagameTV on labwc"
exec nagametv --kiosk
