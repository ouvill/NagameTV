[Unit]
Description=NagameTV Wayland kiosk on tty1
ConditionPathExists=/dev/tty1
Wants=dbus.socket systemd-logind.service nagametv-hdmi-audio.service
After=dbus.socket systemd-logind.service systemd-user-sessions.service plymouth-quit.service getty@tty1.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=exec
User=nagametv
PAMName=nagametv-kiosk
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SEAT=seat0
Environment=XDG_VTNR=1
Environment=LIBSEAT_BACKEND=logind
Environment=WLR_RENDERER=gles2
Environment=QT_QPA_PLATFORM=wayland
Environment=LANG=ja_JP.UTF-8
Environment=NAGAMETV_DEINTERLACE=greedyl
Environment=NAGAMETV_DEINTERLACE_FIELDS=one
TTYPath=/dev/tty1
TTYReset=yes
# Keep labwc's terminal connected while ExecStop waits for the viewer.
TTYVHangup=no
RuntimeDirectory=nagametv-kiosk
RuntimeDirectoryMode=0700
UtmpIdentifier=tty1
UtmpMode=user
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
# Cage 0.2.1 in Ubuntu 26.04 aborts when a client requests fullscreen before
# its first commit, which NagameTV does in kiosk mode (cage-kiosk/cage#456).
# Switch to the kiosk VT before labwc takes the seat.
ExecStartPre=+/usr/bin/chvt 1
ExecStart=/usr/bin/labwc --config-dir /usr/local/lib/nagametv-appliance/labwc \
    --session /usr/local/lib/nagametv-appliance/start-kiosk
# labwc ends its session when the viewer exits. Keep cgroup cleanup for hangs
# and remaining processes, after giving the viewer a chance to close.
ExecStop=/usr/bin/python3 /usr/local/lib/nagametv-appliance/stop-kiosk.py $MAINPID
KillMode=control-group
TimeoutStopSec=20s
Restart=always
RestartSec=2s

[Install]
WantedBy=multi-user.target
