#!/usr/bin/env bash
set -euo pipefail

missing=()

if ! ldconfig -p 2>/dev/null | grep -E 'libclang(-[0-9]+)?\.so' >/dev/null; then
  missing+=("libclang (libclang-dev)")
fi

for command in Xvfb Xwayland cargo cmake curl dbus-daemon dbus-run-session dbus-send \
  desktop-file-validate dpkg-deb dpkg-shlibdeps eu-strip flatpak glxinfo readelf strip \
  flatpak-builder flock gh git gst-inspect-1.0 gst-launch-1.0 import lld mpv ninja \
  openbox pactl parec pipewire pipewire-pulse pkg-config python3 qmake6 qtpaths6 rustc \
  sha256sum weston wireplumber xdpyinfo xdotool xprop; do
  if ! command -v "$command" >/dev/null 2>&1; then
    missing+=("$command")
  fi
done

# Flatpak's host-side AppStream composer needs GdkPixbuf's SVG loader.
svg_loader=$(dpkg-query --listfiles librsvg2-common 2>/dev/null | grep '/libpixbufloader_svg\.so$' || true)
if [[ -z $svg_loader || ! -f $svg_loader ]]; then
  missing+=("GdkPixbuf:SVG (librsvg2-common)")
fi

if ! fc-match :lang=ja | grep -qi "Noto"; then
  missing+=("font:Noto-CJK")
fi

for module in Qt6Core Qt6DBus Qt6Gui Qt6Qml Qt6Quick Qt6Svg aribb24 \
  gstreamer-1.0 gstreamer-app-1.0 gstreamer-mpegts-1.0 mpv; do
  if ! pkg-config --exists "$module"; then
    missing+=("pkg-config:$module")
  fi
done

if ! python3 -c 'import tomllib' >/dev/null 2>&1; then
  missing+=("Python 3.11+ (tomllib)")
fi
if ! python3 -c 'import dbus; import gi' >/dev/null 2>&1; then
  missing+=("Python dbus and PyGObject (python3-dbus, python3-gi)")
fi
if ! pkg-config --atleast-version=6.8 Qt6Core; then
  missing+=("Qt6Core>=6.8")
fi
if ! pkg-config --atleast-version=1.24 gstreamer-1.0; then
  missing+=("gstreamer-1.0>=1.24")
fi
# Inspect installed files instead of scanning the system plugin registry, whose
# optional hardware plugins can probe devices during registration.
gst_plugins_dir=$(pkg-config --variable=pluginsdir gstreamer-1.0 2>/dev/null || true)
for plugin in app audioconvert audiofx audioparsers audioresample autodetect coreelements \
  deinterlace libav mpegtsdemux nvcodec opengl playback pulseaudio qml6 soup \
  typefindfunctions va videoconvertscale videofiltersbad videoparsersbad volume; do
  if [[ -z "$gst_plugins_dir" || ! -f "$gst_plugins_dir/libgst$plugin.so" ]]; then
    missing+=("GStreamer:libgst$plugin.so")
  fi
done
gst_scanner_dir=$(pkg-config --variable=pluginscannerdir gstreamer-1.0 2>/dev/null || true)
if [[ -z "$gst_scanner_dir" || ! -x "$gst_scanner_dir/gst-plugin-scanner" ]]; then
  missing+=("GStreamer:gst-plugin-scanner")
fi

qt_plugins_dir=$(qtpaths6 --query QT_INSTALL_PLUGINS 2>/dev/null || true)
qt_host_bins=$(qtpaths6 --query QT_HOST_BINS 2>/dev/null || true)
qt_host_libexecs=$(qtpaths6 --query QT_HOST_LIBEXECS 2>/dev/null || true)
qt_qml_dir=$(qtpaths6 --query QT_INSTALL_QML 2>/dev/null || true)
if [[ -z "$qt_host_libexecs" || ! -x "$qt_host_libexecs/qmlimportscanner" ]]; then
  missing+=("Qt6:qmlimportscanner (qt6-declarative-dev-tools)")
fi
for module in QtCore QtQml QtQml/Models QtQml/WorkerScript QtQuick QtQuick/Controls \
  QtQuick/Dialogs QtQuick/Effects QtQuick/Layouts QtQuick/Shapes QtQuick/Templates \
  QtQuick/Window QtTest; do
  if [[ -z "$qt_qml_dir" || ! -f "$qt_qml_dir/$module/qmldir" ]]; then
    missing+=("QML:$module")
  fi
done
if [[ -z "$qt_host_bins" || ! -x "$qt_host_bins/lrelease" ]]; then
  missing+=("Qt6:lrelease (qt6-l10n-tools)")
fi
if [[ -z "$qt_plugins_dir" || ! -d "$qt_plugins_dir" ]]; then
  missing+=("Qt6:plugin-directory")
else
  # New Qt versions use qwayland plus a separate EGL integration plugin.
  if [[ ! -f "$qt_plugins_dir/platforms/libqwayland-egl.so" ]] &&
     { [[ ! -f "$qt_plugins_dir/platforms/libqwayland.so" ]] ||
       [[ ! -f "$qt_plugins_dir/wayland-graphics-integration-client/libqt-plugin-wayland-egl.so" ]]; }; then
    missing+=("Qt6:wayland-egl")
  fi
  if [[ ! -f "$qt_plugins_dir/imageformats/libqsvg.so" ]]; then
    missing+=("Qt6:imageformats-svg (qt6-svg-plugins)")
  fi
  if [[ ! -f "$qt_plugins_dir/imageformats/libqwebp.so" ]]; then
    missing+=("Qt6:imageformats-webp (qt6-image-formats-plugins)")
  fi
  if [[ ! -f "$qt_plugins_dir/platforms/libqxcb.so" ]]; then
    missing+=("Qt6:xcb (qt6-qpa-plugins)")
  fi
  if [[ ! -f "$qt_plugins_dir/platformthemes/libqxdgdesktopportal.so" ]]; then
    missing+=("Qt6:xdgdesktopportal (qt6-xdgdesktopportal-platformtheme)")
  fi
fi

if ((${#missing[@]} > 0)); then
  workshopctl set-health error "Missing NagameTV dependencies: ${missing[*]}"
  exit 1
fi

workshopctl set-health okay
