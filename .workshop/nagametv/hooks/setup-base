#!/usr/bin/env bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

# Ubuntu packages for native compilation, Qt/GStreamer runtime resources and
# AppImage/Flatpak/deb packaging. Rust itself comes from the Workshop Rust SDK.
# The trailing '-' removes the old PulseAudio daemon in the same transaction;
# pulseaudio-utils contains clients used with pipewire-pulse.
apt-get update
apt-get install --yes --no-install-recommends \
  build-essential \
  ca-certificates \
  cmake \
  curl \
  dbus-daemon \
  dbus-bin \
  desktop-file-utils \
  dpkg-dev \
  elfutils \
  flatpak \
  flatpak-builder \
  fonts-noto-cjk \
  gh \
  git \
  gstreamer1.0-libav \
  gstreamer1.0-gl \
  gstreamer1.0-plugins-bad \
  gstreamer1.0-plugins-base \
  gstreamer1.0-plugins-good \
  gstreamer1.0-qt6 \
  gstreamer1.0-tools \
  gstreamer1.0-x \
  libgstreamer-plugins-bad1.0-dev \
  libgstreamer-plugins-base1.0-dev \
  libgstreamer1.0-dev \
  libaribb24-dev \
  libclang-dev \
  libmpv-dev \
  libqt6svg6 \
  librsvg2-common \
  lld \
  mesa-utils \
  imagemagick \
  ninja-build \
  openbox \
  mpv \
  pkg-config \
  pipewire \
  pipewire-pulse \
  pulseaudio- \
  pulseaudio-utils \
  python3 \
  python3-dbus \
  python3-gi \
  qmake6 \
  qml6-module-qtcore \
  qml6-module-qtqml \
  qml6-module-qtqml-models \
  qml6-module-qtqml-workerscript \
  qml6-module-qtquick \
  qml6-module-qtquick-controls \
  qml6-module-qtquick-dialogs \
  qml6-module-qtquick-effects \
  qml6-module-qtquick-layouts \
  qml6-module-qtquick-shapes \
  qml6-module-qtquick-templates \
  qml6-module-qtquick-window \
  qml6-module-qttest \
  qt6-base-dev \
  qt6-declarative-dev \
  qt6-declarative-dev-tools \
  qt6-l10n-tools \
  qt6-image-formats-plugins \
  qt6-svg-plugins \
  qt6-wayland \
  qt6-xdgdesktopportal-platformtheme \
  util-linux \
  weston \
  wireplumber \
  x11-utils \
  xdotool \
  xwayland \
  xvfb
