#!/bin/sh
set -eu

# Remove only the export installed by the previous version of this SDK.
# Each test session now supplies its own private PulseAudio endpoint.
for profile_path in "$HOME/.profile" "$HOME/.bashrc"; do
  if [ -f "$profile_path" ]; then
    sed -i '\|^export PULSE_SERVER=tcp:127\.0\.0\.1:4713$|d' "$profile_path"
  fi
done
