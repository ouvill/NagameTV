#!/usr/bin/env bash
set -euo pipefail

missing=()

for command in Xvfb cargo cmake gst-launch-1.0 import mpv ninja openbox pkg-config rustc xdpyinfo xdotool; do
  if ! command -v "$command" >/dev/null 2>&1; then
    missing+=("$command")
  fi
done

if ! gst-inspect-1.0 playbin3 >/dev/null 2>&1; then
  missing+=("gstreamer:playbin3")
fi
if ! gst-inspect-1.0 qml6glsink >/dev/null 2>&1; then
  missing+=("gstreamer:qml6glsink")
fi
if ! gst-inspect-1.0 glupload >/dev/null 2>&1; then
  missing+=("gstreamer:glupload")
fi
if ! fc-match :lang=ja | grep -qi "Noto"; then
  missing+=("font:Noto-CJK")
fi

for module in Qt6Core Qt6Gui Qt6Qml Qt6Quick aribb24 gstreamer-1.0 mpv; do
  if ! pkg-config --exists "$module"; then
    missing+=("pkg-config:$module")
  fi
done

if [[ ! -f /usr/lib/x86_64-linux-gnu/qt6/plugins/platforms/libqwayland-egl.so ]] &&
   [[ ! -f /usr/lib/aarch64-linux-gnu/qt6/plugins/platforms/libqwayland-egl.so ]]; then
  missing+=("Qt6:wayland-egl")
fi

if [[ ! -f /usr/lib/x86_64-linux-gnu/qt6/plugins/imageformats/libqsvg.so ]] &&
   [[ ! -f /usr/lib/aarch64-linux-gnu/qt6/plugins/imageformats/libqsvg.so ]]; then
  missing+=("Qt6:imageformats-svg")
fi

if ((${#missing[@]} > 0)); then
  workshopctl set-health error "Missing Mirakurun Viewer dependencies: ${missing[*]}"
  exit 1
fi

workshopctl set-health okay
